{
  "name": "@myclaw/gateway",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "MyClaw control plane: wraps OpenClaw Gateway (Node)",
  "exports": {
    ".": "./src/defaults.mjs"
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "openclaw:gateway": "node ../../openclaw/openclaw.mjs gateway run",
    "openclaw:gateway:coding-cn": "OPENCLAW_CONFIG_PATH=\"${OPENCLAW_CONFIG_PATH:-$PWD/config/openclaw.coding-plan.cn.json}\" node ../../openclaw/openclaw.mjs gateway run"
  }
}
