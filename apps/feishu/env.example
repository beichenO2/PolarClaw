# Feishu (飞书) or Lark (国际版) custom app credentials
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Event subscription: URL verification & optional payload encryption
# Create in app → Events & callbacks → Encrypt Key / Verification Token
FEISHU_VERIFICATION_TOKEN=
# Leave empty if encryption is disabled for the app; required for some webhook setups
FEISHU_ENCRYPT_KEY=

# Optional: feishu (default, open.feishu.cn) or lark (open.larksuite.com)
# FEISHU_DOMAIN=feishu

# Optional: comma-separated sender open_id values; when set, only these users are handled
# FEISHU_ALLOW_FROM=

# Webhook mode (HTTP) — defaults shown
# FEISHU_WEBHOOK_HOST=127.0.0.1
# FEISHU_WEBHOOK_PORT=3000
# FEISHU_WEBHOOK_PATH=/feishu/events
