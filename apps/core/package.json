  "bin": {
    "myclaw-agent": "./src/index.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
