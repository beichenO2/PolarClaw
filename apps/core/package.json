    "@myclaw/gateway": "*",
    "@myclaw/llm": "*",
    "@myclaw/memory": "*",
    "@myclaw/proactive": "*",
    "@myclaw/research": "*",
    "@myclaw/runtime": "*",
    "@myclaw/skills": "*",
    "@myclaw/telegram": "*",
    "@myclaw/web": "*",
    "@myclaw/yolo": "*"
  }
}
