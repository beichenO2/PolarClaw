{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolarPilot Approvals Contract",
  "description": "Contract for approval request/callback operations via PolarPilot",
  "definitions": {
    "ApprovalStatus": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "expired"]
    },
    "PilotApprovalRequest": {
      "type": "object",
      "required": ["id", "project_id", "requester", "action", "description", "status", "created_at"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "project_id": { "type": "string" },
        "requester": { "type": "string" },
        "action": { "type": "string" },
        "description": { "type": "string" },
        "status": { "$ref": "#/definitions/ApprovalStatus" },
        "created_at": { "type": "string", "format": "date-time" },
        "resolved_at": { "type": "string", "format": "date-time" },
        "resolved_by": { "type": "string" }
      }
    },
    "ApprovalCreateRequest": {
      "type": "object",
      "required": ["project_id", "requester", "action"],
      "properties": {
        "project_id": { "type": "string" },
        "requester": { "type": "string" },
        "action": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "ApprovalCallbackRequest": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["approved", "rejected"] },
        "comment": { "type": "string" }
      }
    }
  },
  "examples": {
    "create_request": {
      "method": "POST",
      "path": "/api/pilot/approvals",
      "body": {
        "project_id": "knowlever",
        "requester": "project:knowlever",
        "action": "deploy_wiki",
        "description": "Deploy updated wiki to production"
      }
    },
    "create_response": {
      "id": "b2c3d4e5-f6a7-8901-bcde-f23456789012",
      "project_id": "knowlever",
      "requester": "project:knowlever",
      "action": "deploy_wiki",
      "description": "Deploy updated wiki to production",
      "status": "pending",
      "created_at": "2026-05-03T01:00:00Z"
    }
  }
}
