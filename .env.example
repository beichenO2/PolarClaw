# === LLM 配置 (通过 PolarPrivate /v1 统一网关，只需指定 model 名称) ===
POLARCLAW_LLM_API_KEY=proxy-managed
POLARCLAW_LLM_BASE_URL=http://127.0.0.1:12790/v1
POLARCLAW_MODEL_CODING=qwen3-coder-plus
POLARCLAW_MODEL_RESEARCH=qwen3.6-plus
POLARCLAW_MODEL_VISION=qwen3.6-plus
POLARCLAW_MODEL_GENERAL=qwen3.6-plus
POLARCLAW_TEMPERATURE=0.7
POLARCLAW_MAX_TOKENS=4096
POLARCLAW_MAX_TOOL_ROUNDS=10
POLARCLAW_LLM_TIMEOUT_MS=120000

# === 记忆 ===
POLARCLAW_DB_PATH=.data/polarclaw.db

# === 隐私 ===
POLARPRIVATE_URL=http://127.0.0.1:12790
POLARCLAW_SECRET_INTERCEPTION=true

# === 通道 ===
POLARCLAW_FEISHU=0
POLARCLAW_CLI=1

# === 主动关怀引擎 ===
POLARCLAW_PROACTIVE=1

# === Clock 集成 ===
CLOCK_API_URL=http://127.0.0.1:15550
CLOCK_DEFAULT_USERNAME=mac

# === 飞书通道（由 PolarPrivate Vault 注入，以下为示例值/占位符）===
# 注意：真实凭证通过 PolarPrivate Vault secrets-loader 注入，不要在此填入生产值
POLARCLAW_FEISHU=1
# 传输方式：websocket（推荐，无需公网 IP）或 webhook
FEISHU_TRANSPORT=websocket
# 飞书 SDK 域：feishu（国内）或 lark（海外）
FEISHU_DOMAIN=feishu

# ── 管理员 Bot（FEISHU_ADMIN_*）──────────────────────────────────────────
# 必填项
FEISHU_ADMIN_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_ADMIN_APP_SECRET=your_admin_app_secret_here
FEISHU_ADMIN_VERIFICATION_TOKEN=your_admin_verification_token_here
# 可选项
FEISHU_ADMIN_ENCRYPT_KEY=your_admin_encrypt_key_here
# Webhook 模式专用（FEISHU_TRANSPORT=webhook 时生效）
FEISHU_ADMIN_WEBHOOK_HOST=127.0.0.1
FEISHU_ADMIN_WEBHOOK_PORT=3001
FEISHU_ADMIN_WEBHOOK_PATH=/feishu/events
# 消息白名单：逗号分隔的 open_id（空 = 不限制）
FEISHU_ADMIN_ALLOW_FROM=

# ── 女友 Bot（FEISHU_GIRLFRIEND_*）──────────────────────────────────────
# 必填项
FEISHU_GIRLFRIEND_APP_ID=cli_yyyyyyyyyyyyyyyy
FEISHU_GIRLFRIEND_APP_SECRET=your_gf_app_secret_here
FEISHU_GIRLFRIEND_VERIFICATION_TOKEN=your_gf_verification_token_here
# 可选项
FEISHU_GIRLFRIEND_ENCRYPT_KEY=your_gf_encrypt_key_here
# Webhook 模式专用
FEISHU_GIRLFRIEND_WEBHOOK_HOST=127.0.0.1
FEISHU_GIRLFRIEND_WEBHOOK_PORT=3002
FEISHU_GIRLFRIEND_WEBHOOK_PATH=/feishu/gf/events
# 消息白名单
FEISHU_GIRLFRIEND_ALLOW_FROM=

# === Hub Web 集成 ===
# Hub Web 服务地址
HUB_WEB_URL=http://127.0.0.1:8765
# 启用 Hub Web 模式（也可用 MODE=hub-web）
HUB_WEB_ENABLED=0
# Hub 模型配置
HUB_MAIN_MODEL=qwen-3.6-plus
HUB_SUBAGENT_MODEL=qwen-3.6-plus

# === 生态健康聚合（/api/ecosystem/status 使用）===
POLARPILOT_URL=http://127.0.0.1:4900
POLARPRIVATE_URL=http://127.0.0.1:12790
SOTAGENT_URL=http://127.0.0.1:12780
