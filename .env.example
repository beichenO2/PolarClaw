# === LLM (required) — Coding Plan on DashScope ===
MYCLAW_LLM_API_KEY=
MYCLAW_LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
MYCLAW_LLM_DEFAULT_MODEL=qwen3.6-plus

# === Telegram (optional) ===
MYCLAW_TELEGRAM=0
TELEGRAM_BOT_TOKEN=

# === Feishu (optional) ===
MYCLAW_FEISHU=0
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# === Memory ===
MYCLAW_MEMORY_DB=.data/memory.db

# === Evolution (auto-check model docs daily) ===
MYCLAW_EVOLUTION=1
MYCLAW_EVOLUTION_CHECK_MS=86400000

# === Web Dashboard ===
MYCLAW_WEB_PORT=3000
