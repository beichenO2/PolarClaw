# === LLM 配置 (通过 PolarPrivate Proxy，无需 API Key) ===
MYCLAW_LLM_API_KEY=proxy-managed
MYCLAW_LLM_BASE_URL=http://127.0.0.1:12790/proxy/llm.aliyun.codingplan/v1
MYCLAW_MODEL_CODING=qwen3-coder-plus
MYCLAW_MODEL_RESEARCH=qwen3.6-plus
MYCLAW_MODEL_VISION=qwen3.6-plus
MYCLAW_MODEL_GENERAL=qwen3.6-plus
MYCLAW_TEMPERATURE=0.7
MYCLAW_MAX_TOKENS=4096
MYCLAW_MAX_TOOL_ROUNDS=10
MYCLAW_LLM_TIMEOUT_MS=120000

# === 记忆 ===
MYCLAW_DB_PATH=.data/myclaw.db

# === 隐私 ===
POLARPRIVATE_URL=http://127.0.0.1:12790
MYCLAW_SECRET_INTERCEPTION=true

# === 通道 ===
MYCLAW_FEISHU=0
MYCLAW_CLI=1

# === 主动关怀引擎 ===
MYCLAW_PROACTIVE=0

# === Clock 集成 ===
CLOCK_API_URL=http://127.0.0.1:15550
