# === LLM (required) — Coding Plan on DashScope ===
MYCLAW_LLM_API_KEY=
MYCLAW_LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
MYCLAW_LLM_DEFAULT_MODEL=qwen3.6-plus

# === Users ===
MYCLAW_USERS_DB=.data/users.db
MYCLAW_ADMIN_NAME=管理员
MYCLAW_GIRLFRIEND_NAME=女友

# === Telegram (optional) ===
MYCLAW_TELEGRAM=0
TELEGRAM_BOT_TOKEN=
# Multi-bot mode: separate admin and girlfriend bots
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_GIRLFRIEND_BOT_TOKEN=

# === Feishu (optional) ===
MYCLAW_FEISHU=0
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# Multi-bot mode: separate admin and girlfriend apps
FEISHU_ADMIN_APP_ID=
FEISHU_ADMIN_APP_SECRET=
FEISHU_GIRLFRIEND_APP_ID=
FEISHU_GIRLFRIEND_APP_SECRET=

# === Privacy (local LLM for sensitive data) ===
MYCLAW_OLLAMA_URL=http://127.0.0.1:11434
MYCLAW_OLLAMA_MODEL=qwen2.5:7b

# === Memory ===
MYCLAW_MEMORY_DB=.data/memory.db

# === Evolution (auto-check model docs daily) ===
MYCLAW_EVOLUTION=1
MYCLAW_EVOLUTION_CHECK_MS=86400000

# === Web Dashboard ===
MYCLAW_WEB_PORT=3000
