# === LLM 配置 (通过 PolarPrivate /v1 统一网关，只需指定 model 名称) ===
POLARCLAW_LLM_API_KEY=proxy-managed
POLARCLAW_LLM_BASE_URL=http://127.0.0.1:12790/v1
POLARCLAW_MODEL_CODING=qwen3-coder-plus
POLARCLAW_MODEL_RESEARCH=qwen3.6-plus
POLARCLAW_MODEL_VISION=qwen3.6-plus
POLARCLAW_MODEL_GENERAL=qwen3.6-plus
POLARCLAW_TEMPERATURE=0.7
POLARCLAW_MAX_TOKENS=4096
POLARCLAW_MAX_TOOL_ROUNDS=10
POLARCLAW_LLM_TIMEOUT_MS=120000

# === 记忆 ===
POLARCLAW_DB_PATH=.data/polarclaw.db

# === 隐私 ===
POLARPRIVATE_URL=http://127.0.0.1:12790
POLARCLAW_SECRET_INTERCEPTION=true

# === 通道 ===
POLARCLAW_FEISHU=0
POLARCLAW_CLI=1

# === 主动关怀引擎 ===
POLARCLAW_PROACTIVE=1

# === Clock 集成 ===
CLOCK_API_URL=http://127.0.0.1:15550
CLOCK_DEFAULT_USERNAME=mac

# === 飞书通道（凭证由 PolarPrivate D-class grant 注入，无需在此配置）===
# 启用飞书通道（默认关闭）
# POLARCLAW_FEISHU=1
# 传输方式：websocket（推荐，无需公网 IP）或 webhook
FEISHU_TRANSPORT=websocket
# 飞书 SDK 域：feishu（国内）或 lark（海外）
FEISHU_DOMAIN=feishu
# 飞书 APP_ID/APP_SECRET/VERIFICATION_TOKEN 等凭证
# 由 PolarPrivate D-class grant 自动注入 process.env，不要在此填写
# 需要在 PolarPrivate 中配置 feishu-admin / feishu-girlfriend 两个 service 的 secret

# === Hub Web 集成 ===
# Hub Web 服务地址（SOTAgent Hub 端口，默认 8040）
HUB_WEB_URL=http://127.0.0.1:8040
# 启用 Hub Web 模式（也可用 MODE=hub-web）
HUB_WEB_ENABLED=0
# Hub 模型配置
HUB_MAIN_MODEL=qwen-3.6-plus
HUB_SUBAGENT_MODEL=qwen-3.6-plus

# === 生态健康聚合（/api/ecosystem/status 使用）===
POLARPILOT_URL=http://127.0.0.1:4900
POLARPRIVATE_URL=http://127.0.0.1:12790
SOTAGENT_URL=http://127.0.0.1:12780
